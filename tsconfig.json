{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ES2020",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "out",
		"strict": true,
		"lib": [
			"es6",
			"es2016",
			"es2017.object"
		]
	},
	"include": [
		"./lib/**/*.ts",
		"./src/**/*.ts"
	],
	"noEmit": true
}
